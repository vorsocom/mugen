{
  "runtime": {
    "spawn_hypercorn": true,
    "hypercorn_cmd": "__HYPERCORN_CMD__",
    "health_url": "http://127.0.0.1:8081/api/core/acp/v1/auth/.well-known/jwks.json",
    "startup_timeout_secs": 30
  },
  "base_url": "http://127.0.0.1:8081/api/core/acp/v1",
  "credentials": {
    "username": "admin",
    "password": "aDmin,123"
  },
  "tenant_id": null,
  "entity_set": "KnowledgePacks",
  "create_payload": {
    "Key": "__PACK_KEY__",
    "Name": "Knowledge Pack __PACK_KEY__"
  },
  "lookup": {
    "field": "Key",
    "value": "__PACK_KEY__"
  },
  "status_field": "Key",
  "actions": [],
  "assertions": {
    "final_status": null,
    "event_entity_set": "KnowledgeApprovals",
    "event_entity_id_field": "KnowledgePackVersionId",
    "event_type_field": "ApprovalType",
    "expected_event_sequence": []
  },
  "negative_creates": [
    {
      "name": "missing_pack_reference",
      "entity_set": "KnowledgePackVersions",
      "expect_code": 400,
      "payload": {
        "VersionNumber": 1
      }
    },
    {
      "name": "projection_is_system_created",
      "entity_set": "KnowledgeIndexProjections",
      "expect_code": 405,
      "payload": {}
    }
  ],
  "positive_creates": [
    {
      "name": "initial_pack_version",
      "entity_set": "KnowledgePackVersions",
      "expect_code": 201,
      "payload": {
        "KnowledgePackId": "__ENTITY_ID__",
        "VersionNumber": 1
      }
    },
    {
      "name": "second_pack_version",
      "entity_set": "KnowledgePackVersions",
      "expect_code": 201,
      "payload": {
        "KnowledgePackId": "__ENTITY_ID__",
        "VersionNumber": 2
      }
    }
  ],
  "collection_queries": [
    {
      "name": "enum_contains",
      "entity_set": "KnowledgePackVersions",
      "expect_code": 200,
      "params": {
        "$filter": "contains(Status,'RAF')",
        "$orderby": "VersionNumber desc"
      },
      "expect_count": 2,
      "expect_first": {
        "VersionNumber": 2,
        "Status": "draft"
      }
    },
    {
      "name": "enum_startswith",
      "entity_set": "KnowledgePackVersions",
      "expect_code": 200,
      "params": {
        "$filter": "startswith(Status,'DRA')"
      },
      "expect_count": 2
    },
    {
      "name": "enum_endswith",
      "entity_set": "KnowledgePackVersions",
      "expect_code": 200,
      "params": {
        "$filter": "endswith(Status,'AFT')"
      },
      "expect_count": 2
    },
    {
      "name": "enum_and_nullable_string_with_pagination",
      "entity_set": "KnowledgePackVersions",
      "expect_code": 200,
      "params": {
        "$filter": "contains(Status,'draft') or contains(Note,'searchable')",
        "$orderby": "VersionNumber desc",
        "$top": 1,
        "$skip": 1
      },
      "expect_count": 1,
      "expect_first": {
        "VersionNumber": 1,
        "Status": "draft"
      }
    },
    {
      "name": "enum_and_nullable_string_non_match",
      "entity_set": "KnowledgePackVersions",
      "expect_code": 200,
      "params": {
        "$filter": "contains(Status,'missing') or contains(Note,'missing')"
      },
      "expect_count": 0
    },
    {
      "name": "projection_resource_is_tenant_readable",
      "entity_set": "KnowledgeIndexProjections",
      "expect_code": 200,
      "params": {
        "$orderby": "RequestedAt desc",
        "$top": 1
      },
      "expect_count": 0
    }
  ]
}
